# =================================================================
# AgroBridge Backend Environment Variables
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/agrobridge

# JWT Secret for Role-Based Authentication
JWT_SECRET=agrobridge_jwt_super_secret_key_sih2026_dev

# =================================================================
# Government of India Open Government Data (OGD) Platform
# Dataset: Current Daily Price of Various Commodities from Various Markets (Mandi)
# Official Source: https://data.gov.in/
# =================================================================

# Official OGD Server-side API Key (Keep secret, never commit real key, never expose to frontend)
OGD_API_KEY=your_server_side_ogd_api_key_here

# Official Dataset Resource ID on data.gov.in
OGD_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# OGD API Base URL Endpoint
OGD_API_BASE_URL=https://api.data.gov.in/resource

# Mandi Price Cache Time-To-Live in seconds (Default: 900 seconds = 15 minutes)
MANDI_PRICE_CACHE_TTL=900

# Backward-compatible API Key Aliases
DATA_GOV_IN_API_KEY=your_server_side_ogd_api_key_here
